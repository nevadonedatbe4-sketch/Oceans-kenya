# Dependencies
node_modules/

# Build output (vite outDir is "out"; "dist" kept in case it changes)
out/
dist/
*.local

# Generated type declarations (unplugin-auto-import writes this each run)
auto-imports.d.ts

# Environment — set these in Vercel/Supabase dashboards, not in the repo
.env
.env.local
.env.*.local

# Supabase CLI
.supabase/
supabase/.temp/
supabase/.branches/

# Logs & caches
*.log
.cache/
.vite/
.eslintcache
*.tsbuildinfo

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code (local dev tooling — launch config, settings; not needed by Vercel)
.claude/
